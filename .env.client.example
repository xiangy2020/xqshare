# xqshare 客户端环境变量配置
# 复制此文件为 .env.client 并修改配置
# cp .env.client.example .env.client

# ==================== 远端服务连接配置 ====================
# 服务端地址
XQSHARE_REMOTE_HOST=21.214.136.216
# 服务端端口
XQSHARE_REMOTE_PORT=18812

# ==================== 客户端认证配置 ====================
# 客户端标识（需与服务端 clients.yaml 中配置的客户端名称一致）
XQSHARE_CLIENT_ID=enterprise-user
# 客户端密钥（需与服务端 clients.yaml 中配置的 secret 一致）
XQSHARE_CLIENT_SECRET=xqs-a7f3k9m2p8q1r5t6w4y0z

# ==================== 可选配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
# XQSHARE_LOG_LEVEL=INFO
# 输出格式: table, json, csv
# XQSHARE_FORMAT=table
