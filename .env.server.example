# xqshare 服务端环境变量配置
# 复制此文件为 .env 并修改配置
# cp .env.server.example .env

# ==================== 服务配置 ====================
# 服务监听端口
XQSHARE_PORT=18812

# ==================== QMT 配置 ====================
# QMT 客户端 userdata_mini 目录路径
QMT_USERDATA_PATH=C:\QMT\userdata_mini

# 默认资金账号（可选）
QMT_ACCOUNT_ID=你的资金账号

# QMT datadir 文件解析路径（用于 xqshare.datadir 功能）
# 优先级：QMT_DATADIR_PATH > xtdata.get_data_dir() 自动推断
# 若不配置，系统将尝试通过 xtdata.get_data_dir() 自动推断主数据目录
# 示例（国金证券）：QMT_DATADIR_PATH=D:\国金证券QMT交易端\datadir
# 示例（通用路径）：QMT_DATADIR_PATH=C:\QMT\datadir
# QMT_DATADIR_PATH=

# ==================== 大QMT 退路通道（无感切换） ====================
# 是否启用大QMT 通道（复用 xtquant_big_convert，Redis RPC）
# miniQMT 可用时仍走 mini，不可用时自动切到大QMT 通道
XQSHARE_BIGQMT_ENABLED=false

# 是否允许大QMT 通道下单（双重门禁第一道，默认关闭）
# 需同时在大QMT 端 bigqmt_signal_trader_local_config.py 开启 rpc_allow_order_methods=true
XQSHARE_BIGQMT_ALLOW_ORDER=false

# 强制通道（调试/验证用，生产留空）：'mini' / 'bigqmt' / 空=自动路由
# XQSHARE_FORCE_CHANNEL=

# 通道探测间隔（秒），默认 30
XQSHARE_PROBE_INTERVAL=30

# 大QMT 资金账号（xtquant_big_convert 客户端读此变量）
# BIGQMT_ACCOUNT_ID=你的资金账号

# 大QMT Redis 连接（xtquant_big_convert 客户端读这些变量）
# BIGQMT_REDIS_HOST=127.0.0.1
# BIGQMT_REDIS_PORT=6379
# BIGQMT_REDIS_DB=5
# BIGQMT_REDIS_PASSWORD=
# BIGQMT_REDIS_USERNAME=

# ==================== 下载超时 ====================
# download_* 类调用的超时阈值（秒），默认 600。
# 盘后券商（平安 QMT）挂起时，download 调用会在服务端永久阻塞 worker 线程；
# 超过该阈值后服务端放弃等待并抛 TimeoutError，避免堵死后续下载请求。
XQSHARE_DOWNLOAD_TIMEOUT=600

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
