# xqshare 客户端配置示例
#
# 注意：直接运行 xqshare-server 时会自动生成 clients.yaml，
#       secret 已预填随机密钥，无需手动复制此文件。
#       此文件仅供参考配置结构。
#
# 配置说明：
# - secret: 客户端认证密钥（建议 32 位以上随机字符串）
# - level: 账号等级，决定可访问的 API 权限
#
# 权限等级说明：
# ┌─────────────┬───────────────────────────────────────────────────────────┐
# │ 等级         │ 权限说明                                                           │
# ├─────────────┼───────────────────────────────────────────────────────────┤
# │ free        │ 基础信息 + 日线数据                                                │
# │ plus        │ 基础信息 + 日线 + 分钟线数据                                        │
# │ standard    │ 基础信息 + 日线 + 分钟线 + 实时行情 + 回调功能                       │
# │ premium     │ standard + 交易查询（持仓、资产、委托等）                            │
# │ enterprise  │ premium + 完整交易（下单、撤单）                                   │
# └─────────────┴───────────────────────────────────────────────────────────┘
#
# 安全建议：
# - 生产环境请使用强密码（建议 32 位以上随机字符串）
# - 定期更换密钥
# - 不同客户端使用不同密钥

clients:
  # ==================== 免费用户 ====================
  # 权限：基础信息 + 日线数据
  # free-user:
  #   secret: "请替换为随机字符串"
  #   level: free

  # ==================== 进阶用户 ====================
  # 权限：基础信息 + 日线 + 分钟线数据
  # plus-user:
  #   secret: "请替换为随机字符串"
  #   level: plus

  # ==================== 标准用户 ====================
  # 权限：基础信息 + 日线 + 分钟线 + 实时行情 + 回调功能
  # standard-user:
  #   secret: "请替换为随机字符串"
  #   level: standard

  # ==================== 高级用户 ====================
  # 权限：standard + 交易查询（持仓、资产、委托等）
  # premium-user:
  #   secret: "请替换为随机字符串"
  #   level: premium

  # ==================== 企业用户 ====================
  # 权限：premium + 完整交易（下单、撤单）
  # enterprise-user:
  #   secret: "请替换为随机字符串"
  #   level: enterprise

  # ==================== 自定义示例 ====================
  # 示例：内部测试账号
  # internal-dev:
  #   secret: "dev-only-secret"
  #   level: enterprise

  # 示例：只读分析账号
  # readonly-analyst:
  #   secret: "analyst-secret"
  #   level: standard
